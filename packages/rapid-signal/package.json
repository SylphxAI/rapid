{
  "name": "@rapid/signal",
  "version": "0.0.0",
  "description": "Rapid framework signals with lifecycle integration",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bunup src/index.ts --format esm --dts --target node --minify",
    "clean": "bun rimraf dist .turbo",
    "typecheck": "tsc --noEmit",
    "lint:fix": "biome check --write ."
  },
  "keywords": [
    "rapid",
    "signal",
    "reactive",
    "lifecycle",
    "framework"
  ],
  "author": "Sylphx <hi@sylphx.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SylphxAI/rapid.git",
    "directory": "packages/rapid-signal"
  },
  "homepage": "https://github.com/SylphxAI/rapid/tree/main/packages/rapid-signal#readme",
  "bugs": {
    "url": "https://github.com/SylphxAI/rapid/issues"
  },
  "dependencies": {
    "@rapid/signal-core": "workspace:*"
  },
  "devDependencies": {
    "bunup": "^0.16.10",
    "typescript": "^7.0.2",
    "@biomejs/biome": "^2.3.12",
    "@sylphx/biome-config": "^0.4.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
