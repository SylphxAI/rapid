{
  "name": "@rapid/native",
  "version": "0.0.0",
  "description": "Native renderer for Rapid framework - iOS and Android support",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bunup",
    "dev": "bun run --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint:fix": "biome check --write ."
  },
  "keywords": [
    "rapid",
    "native",
    "react-native",
    "ios",
    "android",
    "mobile"
  ],
  "author": "Rapid Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SylphxAI/rapid.git",
    "directory": "packages/rapid-native"
  },
  "dependencies": {
    "@rapid/runtime": "workspace:*",
    "@rapid/signal": "workspace:*"
  },
  "devDependencies": {
    "bunup": "^0.16.10",
    "typescript": "^7.0.2",
    "@biomejs/biome": "^2.3.12",
    "@sylphx/biome-config": "^0.4.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
